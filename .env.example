# RentBill Pro — Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase credentials:

RENTBILL_SUPABASE_URL=https://your-project-id.supabase.co
RENTBILL_SUPABASE_KEY=your-supabase-anon-key-here

# Alternate standard naming (also supported):
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-anon-key-here
